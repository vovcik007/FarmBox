{
  "name": "farmbox-backend-demo",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "26.13.0" },
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "build": "tsc && node scripts/build-metadata.cjs",
    "start": "node dist/src/server.js"
  },
  "dependencies": { "pg": "8.16.3" },
  "devDependencies": { "@eslint/js": "9.39.1", "@types/node": "26.0.0", "@types/pg": "8.15.6", "eslint": "9.39.1", "tsx": "4.20.6", "typescript": "5.9.3", "typescript-eslint": "8.46.3" }
}
